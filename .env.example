APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,https://d-clic-intelligence-beta.vercel.app

# Freshservice - SERVER SIDE ONLY
FRESHSERVICE_DOMAIN=your-company.freshservice.com
FRESHSERVICE_API_KEY=
FRESHSERVICE_WRITE_ENABLED=false
FRESHSERVICE_TIMEOUT_SECONDS=15
FRESHSERVICE_MAX_CONCURRENCY=5
FRESHSERVICE_WORKSPACE_ID=
COPILOT_TICKET_PAGE_SIZE=30
COPILOT_VISUAL_MAX_PAGES=3

# Conservative safety default. Set this to the real account/plan limit.
FRESHSERVICE_RATE_LIMIT_PER_MINUTE=100
FRESHSERVICE_EMERGENCY_RESERVE_PERCENT=20
FRESHSERVICE_MAX_RETRIES=2

# Copilot LLM - SERVER SIDE ONLY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=45

# Azure AI Speech - SERVER SIDE ONLY
# The browser receives a short-lived bearer token from /api/v1/copilot/voice/token,
# never the subscription key itself.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=fr-FR-DeniseNeural
AZURE_SPEECH_LANGUAGE=fr-FR

# Data
DATABASE_URL=postgresql+psycopg://dclic:dclic@postgres:5432/dclic
REDIS_URL=redis://redis:6379/0
AUTO_CREATE_DATABASE_TABLES=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
