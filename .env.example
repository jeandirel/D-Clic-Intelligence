APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Freshservice
FRESHSERVICE_DOMAIN=your-company.freshservice.com
FRESHSERVICE_API_KEY=
FRESHSERVICE_WRITE_ENABLED=false
FRESHSERVICE_TIMEOUT_SECONDS=15
FRESHSERVICE_MAX_CONCURRENCY=5

# Conservative safety default. Set this to the real account/plan limit.
FRESHSERVICE_RATE_LIMIT_PER_MINUTE=100
FRESHSERVICE_EMERGENCY_RESERVE_PERCENT=20
FRESHSERVICE_MAX_RETRIES=2

# Data
DATABASE_URL=postgresql+psycopg://dclic:dclic@postgres:5432/dclic
REDIS_URL=redis://redis:6379/0
AUTO_CREATE_DATABASE_TABLES=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
